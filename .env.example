# Copy to .env (in the repo root) for local development:  cp .env.example .env
# The backend loads .env from the folder you run `npm run dev` in.

# Local Postgres (SSL is switched off automatically for localhost)
DATABASE_URL=postgres://localhost/songswap

# Any long random string, e.g. from: openssl rand -hex 32
SESSION_SECRET=change-me

# Optional: seed accounts when the users table is empty
# USER1_NAME=
# USER1_PASSWORD=
# USER2_NAME=
# USER2_PASSWORD=

# Optional: better song lookups (the app works without these)
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# TIDAL_CLIENT_ID=
# TIDAL_CLIENT_SECRET=
# YOUTUBE_API_KEY=

# Optional: when daily swaps reset (default America/Los_Angeles)
# RESET_TIMEZONE=America/Los_Angeles

# Optional: push notifications (npx web-push generate-vapid-keys)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=https://song-swap.app
